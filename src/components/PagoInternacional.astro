<style>
    .traza {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        animation: dibujar 0.9s cubic-bezier(0.33, 1, 0.68, 1) forwards;
    }
    .t1 {
        animation-delay: 0.05s;
    }
    .t2 {
        animation-delay: 0.35s;
    }
    .t3 {
        animation-delay: 0.5s;
    }
    .t4 {
        animation-delay: 0.65s;
    }
    @keyframes dibujar {
        to {
            stroke-dashoffset: 0;
        }
    }

    .orbita {
        opacity: 0;
        animation: aparecer 0.7s ease-out 0.9s forwards;
    }
    @keyframes aparecer {
        to {
            opacity: 0.45;
        }
    }

    .tierra {
        animation: girar 20s linear 1.2s infinite;
    }
    @keyframes girar {
        from {
            transform: translateX(0);
        }
        to {
            transform: translateX(-66px);
        }
    }

    .avion {
        offset-path: path("M 60 34 A 49 26 -16 1 1 59.9 34");
        offset-rotate: auto;
        opacity: 0;
        animation:
            orbitar 10s linear 1.1s infinite,
            aparecer-avion 0.5s ease-out 1.1s forwards;
    }
    @keyframes orbitar {
        from {
            offset-distance: 0%;
        }
        to {
            offset-distance: 100%;
        }
    }
    @keyframes aparecer-avion {
        to {
            opacity: 1;
        }
    }

    .avion--atras {
        animation:
            orbitar 10s linear 1.1s infinite,
            mitad-atras 10s steps(1) 1.1s infinite;
    }
    .avion--adelante {
        animation:
            orbitar 10s linear 1.1s infinite,
            mitad-adelante 10s steps(1) 1.1s infinite;
    }
    @keyframes mitad-atras {
        0%,
        50% {
            opacity: 1;
        }
        50.01%,
        100% {
            opacity: 0;
        }
    }
    @keyframes mitad-adelante {
        0%,
        50% {
            opacity: 0;
        }
        50.01%,
        100% {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .traza,
        .orbita,
        .tierra,
        .avion {
            animation: none;
        }
        .traza {
            stroke-dashoffset: 0;
        }
        .orbita {
            opacity: 0.45;
        }
        .avion--atras {
            opacity: 0;
        }
        .avion--adelante {
            opacity: 1;
            offset-distance: 62%;
        }
    }
</style>
