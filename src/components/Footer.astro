---
import IconWhatsApp from "./IconWhatsApp.astro";
import IconInstagram from "./IconInstagram.astro";
import IconTikTok from "./IconTikTok.astro";

const year = new Date().getFullYear();

const whatsapp =
    "https://wa.me/56987401906?text=" +
    encodeURIComponent("Hola! Quiero pedir una invitación 🎉");

const base =
    "flex h-14 w-14 items-center justify-center rounded-full transition-all duration-200 hover:-translate-y-0.5";

const secundario = `${base} border-[1.5px] border-papel/25 text-papel/90 hover:border-acento hover:text-acento`;

const principal = `${base} bg-linear-to-b from-[#12b05a] to-[#0b8a45] text-white shadow-[0_6px_16px_rgba(18,176,90,0.35)] hover:from-[#26e084] hover:to-[#12b05a] hover:shadow-[0_10px_24px_rgba(18,176,90,0.55)]`;
---

<footer class="bg-tinta px-5 pb-10 pt-14 text-papel sm:px-8 lg:px-20">
    <div
        class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center lg:gap-12"
    >
        <div class="flex flex-col gap-2.5">
            <h2 class="titular text-4xl md:text-5xl">¿Ya tienes la fecha?</h2>
            <p class="text-[17px] text-papel/60">
                Escríbenos y te la dejamos lista.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <a
                href={whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Escríbenos por WhatsApp"
                class={principal}
            >
                <IconWhatsApp class="h-[23px] w-[23px] shrink-0" />
            </a>
            <a
                href="https://www.instagram.com/max_invitaciones"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram"
                class={secundario}
            >
                <IconInstagram class="h-[23px] w-[23px] shrink-0" />
            </a>
            <a
                href="https://www.tiktok.com/@maxinvitaciones"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="TikTok"
                class={secundario}
            >
                <IconTikTok class="h-[21px] w-[21px] shrink-0" />
            </a>
        </div>
    </div>

    <div
        class="mt-12 flex flex-col justify-between gap-10 border-t border-papel/10 pt-10 md:flex-row md:items-center"
    >
        <span class="marca">
            MAX
            <span>Invitaciones</span>
        </span>

        <div class="flex flex-col gap-10 sm:flex-row sm:gap-16">
            <div class="flex flex-col gap-3">
                <span
                    class="text-[13px] font-semibold uppercase tracking-[0.06em] text-papel/60"
                    >Sitio</span
                >
                <a
                    href="#invitaciones"
                    class="flex min-h-11 items-center text-[15px] text-papel/85 transition-colors hover:text-acento"
                    >Invitaciones</a
                >
                <a
                    href="#como"
                    class="flex min-h-11 items-center text-[15px] text-papel/85 transition-colors hover:text-acento"
                    >Cómo funciona</a
                >
            </div>

            <div class="flex flex-col gap-3">
                <span
                    class="text-[13px] font-semibold uppercase tracking-[0.06em] text-papel/60"
                    >Contacto</span
                >
                <a
                    href="https://wa.me/56987401906"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex min-h-11 items-center gap-2.5 text-[15px] text-papel/85 transition-colors hover:text-acento"
                >
                    <IconWhatsApp class="h-[18px] w-[18px] shrink-0 text-wasap" />
                    +56 9 8740 1906
                </a>
                <a
                    href="mailto:maxinvitaciones@gmail.com"
                    class="flex min-h-11 items-center gap-2.5 text-[15px] text-papel/85 transition-colors hover:text-acento"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="h-[18px] w-[18px] shrink-0 text-papel/50"
                        aria-hidden="true"
                    >
                        <rect x="3" y="5" width="18" height="14" rx="2.5"></rect>
                        <path d="m3.5 7 8.5 6 8.5-6"></path>
                    </svg>
                    maxinvitaciones@gmail.com
                </a>
            </div>
        </div>
    </div>

    <p class="mt-10 border-t border-papel/10 pt-6 text-[13px] text-papel/60">
        &copy; {year} Max Invitaciones. Todos los derechos reservados.
    </p>
</footer>

<style>
    .marca {
        display: block;
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 56px;
        line-height: 0.86;
        letter-spacing: -0.035em;
        color: var(--color-papel);
    }
    @media (min-width: 768px) {
        .marca {
            font-size: 72px;
        }
    }
    .marca span {
        display: block;
        margin-top: 8px;
        font-family: var(--font-sans);
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: rgba(250, 244, 234, 0.62);
    }
    @media (min-width: 768px) {
        .marca span {
            font-size: 20px;
            letter-spacing: 0.16em;
        }
    }
</style>
