---
const items = ['👑', '🎉', '🎂', '🎁', '✨', '🎈', '🎊', '⚽'];
---
<div class="fixed inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
  {items.map((emoji, i) => (
    <span
      class="floating-item absolute text-3xl md:text-1xl opacity-70"
      style={`left: ${5 + i * 12}%; animation-delay: ${i * 1.3}s; animation-duration: ${14 + (i % 4) * 3}s;`}
    >
      {emoji}
    </span>
  ))}
</div>

<style>
  .floating-item {
    bottom: -10%;
    animation-name: float-up;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes float-up {
    0% {
      transform: translateY(0) translateX(0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.7;
    }
    50% {
      transform: translateY(-50vh) translateX(20px) rotate(15deg);
    }
    90% {
      opacity: 0.7;
    }
    100% {
      transform: translateY(-110vh) translateX(-20px) rotate(-15deg);
      opacity: 0;
    }
  }
</style>