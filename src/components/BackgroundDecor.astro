---
const items = [
  { emoji: '👑' },
  { sticker: 'smile' },
  { emoji: '🎉' },
  { emoji: '🎂' },
  { sticker: 'wink' },
  { emoji: '🎁' },
  { emoji: '✨' },
  { sticker: 'kiss' },
  { emoji: '🎈' },
  { emoji: '🎊' },
  { sticker: 'wow' },
  { emoji: '⚽' },
  { sticker: 'what' },
];

const paso = 94 / (items.length - 1);
---
<div class="fixed inset-0 overflow-hidden pointer-events-none z-0" aria-hidden="true">
  {items.map((item, i) => (
    <span
      class="floating-item absolute text-3xl md:text-1xl opacity-35"
      style={`left: ${3 + i * paso}%; animation-delay: ${i * 1.4}s; animation-duration: ${15 + (i % 5) * 3}s;`}
    >
      {item.emoji ?? (
        <img
          src={`/mascotas/${item.sticker}.png`}
          alt=""
          width="128"
          height="128"
          loading="lazy"
          decoding="async"
          class="block w-11 md:w-14 h-auto"
        />
      )}
    </span>
  ))}
</div>

<style>
  .floating-item {
    bottom: -10%;
    animation-name: float-up;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  @keyframes float-up {
    0% {
      transform: translateY(0) translateX(0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.35;
    }
    50% {
      transform: translateY(-50vh) translateX(20px) rotate(15deg);
    }
    90% {
      opacity: 0.35;
    }
    100% {
      transform: translateY(-110vh) translateX(-20px) rotate(-15deg);
      opacity: 0;
    }
  }
</style>
