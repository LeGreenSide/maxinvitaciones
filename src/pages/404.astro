---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada | Max Invitaciones" description="La página que buscas no existe.">
	<main class="px-4 py-24 flex flex-col items-center justify-center gap-6 text-center min-h-[60vh]">
		<h1 class="text-4xl font-bold">404</h1>
		<p class="text-lg text-blue-950/70">No encontramos la página que buscas.</p>
		<a
			href="/"
			class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-colors"
		>
			Volver al inicio
		</a>
	</main>
</BaseLayout>
